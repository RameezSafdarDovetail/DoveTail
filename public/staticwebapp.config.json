{
  "mimeTypes": {
    ".js": "application/javascript",
    ".mjs": "application/javascript",
    ".css": "text/css",
    ".json": "application/json",
    ".html": "text/html"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.js",
      "/*.mjs",
      "/*.css",
      "/*.json",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,ttf}"
    ]
  }
}
